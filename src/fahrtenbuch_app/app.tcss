Screen {
    layout: vertical;
}

ConfigPanel {
    height: 3;
    margin-bottom: 0;
}

#view-tabs {
    height: 3;
}

#view-switcher {
    height: 1fr;
}

TripTable {
    height: 1fr;
    min-height: 10;
    border: solid $accent;
}

CalendarView {
    height: 1fr;
    min-height: 10;
    border: solid $accent;
}

YearView {
    height: 1fr;
    min-height: 10;
    border: solid $accent;
}

SummaryPanel {
    height: 3;
    margin-top: 0;
}

#log-panel {
    height: 10;
    min-height: 5;
    max-height: 15;
    border-top: solid $accent;
    display: block;
}

#log-panel.hidden {
    display: none;
}
