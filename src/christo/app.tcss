Screen {
    layout: vertical;
}

ConfigPanel {
    margin-bottom: 0;
}

/* InfoHeader-Overrides fuer ConfigPanel: bei columns=1 muss die
   navigable Zelle (Zeitraum) eng am Wert kleben — sonst reisst die
   Library die Pfeile ueber die volle Panel-Breite. App-level CSS
   gewinnt gegen DEFAULT_CSS der textual_widgets-Library. */
ConfigPanel .info-cell {
    width: auto;
}
ConfigPanel .info-value {
    width: auto;
}
ConfigPanel .info-nav {
    width: auto;
}
ConfigPanel .info-nav-value {
    width: auto;
    padding: 0 1;
}

#view-tabs {
    height: 3;
}

#view-switcher {
    height: 1fr;
}

TripTable {
    height: 1fr;
    min-height: 10;
    border: solid $accent;
}

CalendarView {
    height: 1fr;
    min-height: 10;
    border: solid $accent;
}

YearView {
    height: 1fr;
    min-height: 10;
    border: solid $accent;
}

BlacklistView {
    height: 1fr;
    min-height: 10;
    border: solid $accent;
}

/* Keine Hoehenvorgabe: die StatusBar steht auf height: auto, weil ihr
   Rahmen zwei Zeilen mehr braucht. Mit height: 1 waere er abgeschnitten. */
SummaryPanel {
    margin-top: 0;
}

SummaryPanel.hidden {
    display: none;
}

#log-splitter {
    height: 1;
}

#log-splitter.hidden {
    display: none;
}

#log-panel {
    height: 10;
    min-height: 3;
    max-height: 40;
}

#log-panel.hidden {
    display: none;
}
